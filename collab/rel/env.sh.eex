#!/bin/sh
# Ambiente de runtime do release OTP `collab` (spec 002, task 3). Sourced pelo
# `bin/collab` a cada arranque. Define apenas PADRÕES: o systemd sobrepõe estes
# valores via EnvironmentFile (/etc/machv4/collab.env) no host — segredos e
# endpoints reais nunca vão no artefato.

# Habilita o servidor HTTP do Phoenix ao iniciar (bin/collab start) — RF02.
export PHX_SERVER="${PHX_SERVER:-true}"

# Porta HTTP servida atrás do Nginx (proxy reverso do host) — contrato do smoke test.
export PORT="${PORT:-4000}"

# Collector de observabilidade do ambiente (RNF06). Os spans (Fase 9) são
# exportados via OTLP/gRPC ao Collector alcançável a partir do host.
export OTEL_EXPORTER_OTLP_ENDPOINT="${OTEL_EXPORTER_OTLP_ENDPOINT:-http://localhost:4317}"

# Endereço gRPC do Design Engine para o flush write-behind (RN06 da spec 001).
export DESIGN_GRPC_ADDR="${DESIGN_GRPC_ADDR:-localhost:50052}"

# Redis para snapshots incrementais da colaboração (opcional; sem REDIS_URL o
# store opera em modo Noop). Deixado sem default para não presumir um Redis local.
# export REDIS_URL

# Distribuição do nó: nome curto por padrão (deploy single-host da spec 002).
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
